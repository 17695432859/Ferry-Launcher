{
  "name": "ferry-launcher",
  "version": "0.1.2",
  "description": "Ferry Launcher - a glassmorphic Minecraft Java launcher",
  "main": "./out/main/index.js",
  "author": "Ferry Launcher",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-tauri.mjs --dev",
    "dev:electron": "electron-vite dev",
    "build:web": "vite build -c vite.tauri.config.ts",
    "dist": "node scripts/build-tauri.mjs",
    "dist:electron": "npm run build && electron-builder --win portable",
    "dist:nsis": "npm run build:web && tauri build",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@tauri-apps/cli": "^2.12.5",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "framer-motion": "^11.18.2",
    "postcss": "^8.5.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "skinview3d": "^3.4.2",
    "tailwindcss": "^3.4.19",
    "three": "^0.187.0",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "adm-zip": "^0.6.1",
    "yazl": "^3.3.1"
  }
}
