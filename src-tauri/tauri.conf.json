{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferry Launcher",
  "version": "0.2.0",
  "identifier": "cn.ferry.launcher",
  "build": {
    "frontendDist": "../out/tauri",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite -c vite.tauri.config.ts --port 5173 --strictPort",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Ferry Launcher",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
